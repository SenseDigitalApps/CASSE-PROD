				{
					"name": "Password Reset Request (Step 1)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"session_token\", jsonData.session_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email_primary\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/password-reset/request/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"password-reset",
								"request",
								""
							]
						},
						"description": "Password Reset Request (Step 1): Solicita recuperación de contraseña. Envía un código OTP por email.\n\nRetorna:\n- session_token: Token temporal para verificar OTP\n- expires_in: Tiempo de expiración en segundos (1200 = 20 minutos)\n\nIMPORTANTE: Después de este paso, debes usar \"Password Reset Verify (Step 2)\" con el código recibido por email para restablecer la contraseña.\n\nNOTA: Por seguridad, siempre retorna el mismo mensaje genérico, incluso si el email no existe."
					},
					"response": []
				},
				{
					"name": "Password Reset Verify (Step 2)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"session_token\": \"{{session_token}}\",\n  \"otp_code\": \"123456\",\n  \"new_password\": \"NewSecurePassword123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/password-reset/verify/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"password-reset",
								"verify",
								""
							]
						},
						"description": "Password Reset Verify (Step 2): Verifica el código OTP y establece la nueva contraseña.\n\nRequiere:\n- session_token: Token recibido en el paso 1\n- otp_code: Código OTP de 6 dígitos recibido por email\n- new_password: Nueva contraseña que debe cumplir las políticas de seguridad\n\nRetorna:\n- message: Confirmación de que la contraseña fue restablecida\n\nNOTA: Después de restablecer la contraseña, el usuario puede hacer login con la nueva contraseña."
					},
					"response": []
				}
			]
